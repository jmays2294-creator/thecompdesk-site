{
  "cleanUrls": true,
  "installCommand": "echo 'static site - skipping install'",
  "redirects": [
    {
      "source": "/calculators/pro.html",
      "destination": "/workspace/",
      "permanent": true
    },
    {
      "source": "/calculators/pro",
      "destination": "/workspace/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terms",
      "permanent": true
    },

    {
      "source": "/for-attorneys",
      "destination": "/attorneys",
      "permanent": true
    },
    {
      "source": "/for-attorneys.html",
      "destination": "/attorneys",
      "permanent": true
    },

    {
      "source": "/hire-attorney",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/hire-attorney.html",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney.html",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney-how-it-works",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney-how-it-works.html",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/home-legacy.html",
      "destination": "/home-legacy",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/connect-with-attorney(.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
