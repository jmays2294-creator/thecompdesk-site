{
  "cleanUrls": true,

  "_comment_install": "This is a pure static site: nothing at deploy time imports node_modules. package.json exists only so the i18n tooling has npm scripts, and its one dependency (opencc-js) is build-time-only — zh-Hant is derived locally and the result is committed. Without this override, the presence of package.json makes Vercel run npm install on every deploy, adding a registry failure mode to a site that previously had none.",
  "installCommand": "echo 'static site - skipping install'",
  "redirects": [
    {
      "source": "/calculators/pro.html",
      "destination": "/workspace/",
      "permanent": true
    },
    {
      "source": "/calculators/pro",
      "destination": "/workspace/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terms",
      "permanent": true
    },

    {
      "source": "/for-attorneys",
      "destination": "/attorneys",
      "permanent": true
    },
    {
      "source": "/for-attorneys.html",
      "destination": "/attorneys",
      "permanent": true
    },

    {
      "source": "/hire-attorney",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/hire-attorney.html",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney.html",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney-how-it-works",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/find-attorney-how-it-works.html",
      "destination": "/connect-with-attorney",
      "permanent": true
    },
    {
      "source": "/home-legacy.html",
      "destination": "/home-legacy",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/connect-with-attorney(.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
