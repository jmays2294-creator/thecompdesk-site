{
  "name": "thecompdesk-site",
  "private": true,
  "type": "module",
  "description": "Static site + i18n build tooling for thecompdesk.com",
  "scripts": {
    "check:refs": "node scripts/check-asset-refs.mjs",
    "check:tiles": "node scripts/check-tile-routes.mjs",
    "i18n:build": "node scripts/i18n/build-locales.mjs",
    "i18n:verify": "node scripts/i18n/verify.mjs",
    "i18n:derive-zh-hant": "node scripts/i18n/derive-zh-hant.mjs",
    "build:directory": "node scripts/build-directory.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "a11y:baseline": "node scripts/a11y-audit.mjs --update",
    "sweep": "node scripts/workspace-sweep.mjs",
    "sweep:selftest": "node scripts/workspace-sweep.mjs --self-test",
    "sweep:live": "node scripts/workspace-sweep.mjs --url https://thecompdesk.com --persona pro",
    "telemetry:privacy": "node tests/telemetry-privacy.test.mjs",
    "guards": "npm run a11y && npm run check:refs && npm run check:tiles && npm run sweep:selftest && npm run telemetry:privacy"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "opencc-js": "^1.0.5",
    "parse5": "^8.0.1",
    "playwright": "^1.62.1"
  }
}
