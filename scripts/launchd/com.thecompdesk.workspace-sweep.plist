<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly Pro-workspace sweep, 02:00 local.

  INSTALL (one time, from the repo root):
    chmod +x scripts/launchd/run-nightly-sweep.sh
    cp scripts/launchd/com.thecompdesk.workspace-sweep.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.thecompdesk.workspace-sweep.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.thecompdesk.workspace-sweep.plist
    launchctl list | grep thecompdesk

  RUN IT NOW to prove it works, rather than finding out in four days:
    launchctl start com.thecompdesk.workspace-sweep
    tail -f ~/Library/Logs/compdesk-sweep.log

  RemoveAtLoad is false and RunAtLoad is false on purpose: loading the agent
  should not kick off a sweep in the middle of the day.

  If the Mac is asleep at 02:00, launchd runs the job at the next wake. That is
  the desired behaviour — a missed night is better than a machine kept awake,
  and the 7:10am triage task reports any run older than 36 hours as a broken
  cron rather than a clean site.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thecompdesk.workspace-sweep</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>"$HOME/Code/thecompdesk-site/scripts/launchd/run-nightly-sweep.sh"</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/compdesk-sweep.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/compdesk-sweep.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
